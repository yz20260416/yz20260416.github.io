<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Travel Guides - Best Time to Visit Cities Worldwide</title>
    <meta name="description" content="Find the best time to visit 77 cities worldwide. Monthly weather data, local culture, attractions, itineraries, and budget guides for travelers.">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background-color: #f8fafc; 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #fafaf9;
            min-height: 100vh;
            color: #333;
        }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px 40px; }
        header { text-align: center; padding: 60px 20px; color: #1e293b; }
        h1 { font-size: 3.2em; font-weight: 700; margin-bottom: 12px; letter-spacing: -0.5px; text-shadow: 0 2px 10px rgba(0,0,0,0.5); }
        .subtitle { font-size: 1.3em; color: #f1f5f9; margin-bottom: 36px; text-shadow: 0 2px 10px rgba(0,0,0,0.5); }
        .search-box { max-width: 600px; margin: 0 auto 40px; position: relative; }
        .search-box input {
            width: 100%; padding: 14px 20px; font-size: 1em; box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            border: none; border-radius: 50px;
            border: none;
        }
        .search-results {
            position: absolute; top: 100%; left: 0; right: 0;
            background: white; border-radius: 20px; margin-top: 10px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            max-height: 300px; overflow-y: auto; display: none;
        }
        .search-results.active { display: block; }
        .search-results a {
            display: block; padding: 15px 24px; color: #333;
            text-decoration: none; border-bottom: 1px solid #eee;
        }
        .section { margin-bottom: 48px; }
        .section + .section {
            border-top: 1px solid #e5e7eb;
            padding-top: 40px;
        }
        .section-title {
            color: #111827; font-size: 1.6em; margin-bottom: 20px;
            padding-left: 14px;
            border-left: 4px solid #ea580c;
        }
        .city-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 16px;
        }
        .city-card {
            background: #ffffff; border-radius: 10px; overflow: hidden;
            border: 1px solid #e5e7eb;
            text-decoration: none; color: inherit;
            transition: border-color 0.15s ease;
        }
        .city-card:hover {
            border-color: #ea580c;
        }
        .city-image {
            height: 120px;
            background: #f5f3ef;
            border-bottom: 1px solid #ebe7e0;
            display: flex; align-items: center; justify-content: center;
            font-size: 2.5em;
        }
        .city-info { padding: 16px; }
        .city-name { font-size: 1.05em; font-weight: bold; margin-bottom: 5px; }
        .city-meta { color: #6b7280; font-size: 0.85em; }
        .temp-badge {
            display: inline-block; background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa;
            padding: 3px 10px; border-radius: 6px; font-size: 0.8em; margin-top: 8px;
        }
        .region-tags { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
        .region-tag {
            background: #ffffff; color: #374151;
            padding: 10px 20px; border-radius: 8px; text-decoration: none;
            border: 1px solid #e5e7eb;
            font-size: 0.95em;
            transition: border-color 0.15s ease;
        }
        .region-tag:hover {
            border-color: #ea580c;
        }
        footer { text-align: center; padding: 40px; color: #64748b; opacity: 0.9; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🌍 Travel Guides</h1>
            <p class="subtitle">Find the perfect time to visit any city</p>
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="🔍 Search city..." autocomplete="off">
                <div class="search-results" id="searchResults"></div>
            </div>
        </header>
        
        <div class="section">
            <h2 class="section-title">☀️ Best Now <span id="currentMonth"></span></h2>
            <div class="city-grid" id="bestNowGrid"></div>
        </div>
        
        <div class="section">
            <h2 class="section-title">🔥 Trending</h2>
            <div class="city-grid" id="trendingGrid"></div>
        </div>
        
        <div class="section">
            <h2 class="section-title">🗺️ Browse by Region</h2>
            <div class="region-tags" id="regionTags"></div>
        </div>
        
        <footer>
            <p>&copy; 2026 Travel Guides</p>
        </footer>
    </div>
    
    <script>
        let cities = [];
        
        const now = new Date();
        const currentMonth = now.getMonth() + 1;
        document.getElementById('currentMonth').textContent = `(${now.toLocaleString('en', {month: 'long'})})`;
        
        function createCityCard(city) {
            return `<a href="cities/${city.slug}.html" class="city-card">
                <div class="city-image">${city.emoji}</div>
                <div class="city-info">
                    <div class="city-name">${city.name}</div>
                    <div class="city-meta">${city.country}</div>
                    <span class="temp-badge">${city.temp}</span>
                </div>
            </a>`;
        }
        
        function renderRegions() {
            const regions = [...new Set(cities.map(c => c.region).filter(Boolean))];
            const label = {asia: "Asia", europe: "Europe", americas: "Americas", africa: "Africa", oceania: "Oceania", "middleeast": "Middle East", "middle-east": "Middle East"};
            const el = document.getElementById('regionTags');
            if (!el) return;
            el.innerHTML = regions.map(r => 
                `<a href="#${r}" class="region-tag" onclick="showRegion('${r}');return false;">${label[r] || r}</a>`
            ).join('');
        }
        
        function showRegion(region) {
            const filtered = cities.filter(c => c.region === region);
            document.getElementById('bestNowGrid').innerHTML = filtered.map(createCityCard).join('');
            document.querySelector('.section-title').scrollIntoView({behavior: 'smooth'});
            document.getElementById('currentMonth').textContent = `— ${region}`;
        }
        
        function renderAll() {
            const bestNow = cities.filter(c => c.bestMonths.includes(currentMonth));
            document.getElementById('bestNowGrid').innerHTML = bestNow.length 
                ? bestNow.map(createCityCard).join('') 
                : '<p style="color:white">No cities match this month.</p>';
            
            const trending = cities.slice(0, 8);
            document.getElementById('trendingGrid').innerHTML = trending.map(createCityCard).join('');
            
            renderRegions();
        }
        
        const searchInput = document.getElementById('searchInput');
        const searchResults = document.getElementById('searchResults');
        
        searchInput.addEventListener('input', function() {
            const q = this.value.toLowerCase().trim();
            if (q.length < 2) {
                searchResults.classList.remove('active');
                return;
            }
            const matches = cities.filter(c => 
                c.name.toLowerCase().includes(q) || c.country.toLowerCase().includes(q)
            ).slice(0, 10);
            if (matches.length === 0) {
                searchResults.innerHTML = '<div style="padding:15px 24px;color:#999">No matches</div>';
            } else {
                searchResults.innerHTML = matches.map(c => 
                    `<a href="cities/${c.slug}.html">${c.emoji} ${c.name}, ${c.country}</a>`
                ).join('');
            }
            searchResults.classList.add('active');
        });
        
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.search-box')) {
                searchResults.classList.remove('active');
            }
        });
        
        fetch('cities-index.json')
            .then(r => r.json())
            .then(data => {
                cities = data;
                renderAll();
                renderRegions();
            })
            .catch(err => {
                console.error('Failed to load cities-index.json', err);
                document.getElementById('bestNowGrid').innerHTML = '<p style="color:white">Failed to load cities.</p>';
            });
    </script>
</body>
</html>
